###############################################################
# CORE GITIGNORE — MERGED & CLEANED FOR SFDX + LWC + VS CODE
###############################################################

## -----------------------------------------------------------
## USER / EDITOR / IDE FILES
## -----------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains / IntelliJ / WebStorm
.idea/
*.iml

# OS-specific
.DS_Store
Thumbs.db

# Backup & Temp Files
*~
*.tmp
*.tmp_proj
*.bak
*.swp

# Logs
*.log
logs/
Log/
log/

###############################################################
# SALESFORCE SPECIFIC
###############################################################

# SFDX project files
.sfdx/
.sf/
.cache/
coverage/
test-results/
deploy/

# Local org config/auth files
**/orgConfig.json
*.sfpluginauth
*.json

# Prevent accidentally committing authentication
*.key
*.pem
server.key
auth.json
credentials.json

# Scratch org definition files if environment-specific
scratch-def.json

###############################################################
# LWC / NODE / JEST
###############################################################

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# LWC test bundles
**/lwc/**/__tests__/
**/lwc/**/tests/

###############################################################
# ENVIRONMENT / SECRETS
###############################################################

.env
.env.*
*.local

###############################################################
# PACKAGE OUTPUT / ARTIFACTS
###############################################################

*.zip
*.tar.gz

###############################################################
# VIDEO FILES (Assignment rule: DO NOT COMMIT VIDEO SUBMISSIONS)
###############################################################

*.mp4
*.mov
*.avi

###############################################################
# MISC — DO NOT REMOVE
###############################################################

# Build / compiled artifacts
bin/
obj/
out/

# Python cache (if helper scripts exist)
__pycache__/
*.pyc

# VS Code History
.history/

# Local TS/JS cache
*.tsbuildinfo
